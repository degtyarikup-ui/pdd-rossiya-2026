  {
    "name": "newest local answer survives a delayed reply",
    "local": {
      "questionProgressAb": {
        "q": {
          "answeredAt": "2026-10-13T10:01:00Z",
          "isCorrect": true,
          "attemptsCount": 2
        },
        "new": {
          "answeredAt": "2026-10-13T10:02:00Z",
          "isCorrect": false
        }
      }
    },
    "remote": {
      "questionProgressAb": {
        "q": {
          "answeredAt": "2026-10-13T10:00:00Z",
          "isCorrect": false,
          "attemptsCount": 1
        }
      }
    },
    "expected": {
      "questionProgressAb": {
        "q": {
          "answeredAt": "2026-10-13T10:01:00Z",
          "isCorrect": true,
          "attemptsCount": 2
        },
        "new": {
          "answeredAt": "2026-10-13T10:02:00Z",
          "isCorrect": false
        }
      }
    }
  },
  {
    "name": "a newer remote answer replaces the local one",
    "local": {
      "questionProgressCd": {
        "q": {
          "answeredAt": 10,
          "isCorrect": false
        }
      }
    },
    "remote": {
      "questionProgressCd": {
        "q": {
          "answeredAt": 20,
          "isCorrect": true
        }
      }
    },
    "expected": {
      "questionProgressCd": {
        "q": {
          "answeredAt": 20,
          "isCorrect": true
        }
      }
    }
  },
  {
    "name": "equal answer dates prefer the larger attempt count",
    "local": {
      "questionProgressAb": {
        "q": {
          "answeredAt": 10,
          "attemptsCount": 3
        }
      }
    },
    "remote": {
      "questionProgressAb": {
        "q": {
          "answeredAt": 10,
          "attemptsCount": 2
        }
      }
    },
    "expected": {
      "questionProgressAb": {
        "q": {
          "answeredAt": 10,
          "attemptsCount": 3
        }
      }
    }
  },
