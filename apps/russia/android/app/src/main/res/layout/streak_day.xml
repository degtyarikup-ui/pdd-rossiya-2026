<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:importantForAccessibility="noHideDescendants">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:id="@+id/streak_day_label"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7dp"
        android:autoSizeMaxTextSize="10dp"
        android:autoSizeStepGranularity="1dp"
        android:maxLines="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="1dp">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="16dp"
            android:id="@+id/streak_day_icon"
            android:src="@drawable/streak_widget_flame"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:layout_gravity="center"/>
    </FrameLayout>
    <ImageView
        android:layout_width="10dp"
        android:layout_height="2dp"
        android:id="@+id/streak_day_today"
        android:layout_marginTop="1dp"
        android:background="@drawable/streak_widget_today_mark"
        android:importantForAccessibility="no"/>
</LinearLayout>
