<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/streak_widget_record_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                android:id="@+id/streak_flame"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:src="@drawable/streak_widget_flame"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/streak_current"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="0"
                    android:textSize="36sp"
                    android:textColor="@color/streak_record_text"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5sp"
                    android:autoSizeMaxTextSize="36sp"
                    android:autoSizeStepGranularity="1sp"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/streak_label"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/currentLabel"
                android:textSize="12sp"
                android:textColor="@color/streak_record_secondary"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="5sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/streak_best"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="🏆 0"
                android:textSize="20sp"
                android:textColor="@color/streak_record_text"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="5sp"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:layout_weight="2"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/streak_best_label"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/bestLabel"
                android:textSize="12sp"
                android:textColor="@color/streak_record_secondary"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="5sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:layout_weight="1" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/streak_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:padding="0dp"
                android:minHeight="0dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/streak_widget_progress" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/streak_status"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="@string/startLabel"
        android:textSize="12sp"
        android:textColor="@color/streak_record_accent"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:gravity="center_vertical"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5sp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />
</LinearLayout>
