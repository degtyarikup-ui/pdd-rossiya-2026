<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/streak_widget_background"
    android:clipToOutline="true"
    android:importantForAccessibility="yes">

    <!-- The light and the flame share the same center, independent of the row width. -->
    <ImageView
        android:id="@+id/streak_rays"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="-46dp"
        android:scaleType="centerCrop"
        android:alpha="0.85"
        android:src="@drawable/streak_widget_rays"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/streak_row_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">
        <ImageView
            android:id="@+id/streak_flame"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/streak_widget_flame"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:weightSum="7"
            android:gravity="center_vertical"
            android:layout_marginStart="7dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/streak_current"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_weight="2"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6dp"
                android:autoSizeMaxTextSize="38dp"
                android:autoSizeStepGranularity="1dp"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/streak_trophy"
                    android:layout_width="13dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/streak_widget_trophy"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/streak_best"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:text="21"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical|start"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6dp"
                    android:autoSizeMaxTextSize="14dp"
                    android:autoSizeStepGranularity="1dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/streak_status_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:src="@drawable/streak_widget_check"
        android:importantForAccessibility="no" />
</FrameLayout>
