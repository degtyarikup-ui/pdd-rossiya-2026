<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/streak_widget_background">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/streak_flame" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥" android:textSize="30sp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/streak_current" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="0" android:textSize="36sp" android:textStyle="bold" android:textColor="@color/streak_widget_text" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="36sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/streak_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/currentLabel" android:textSize="12sp" android:textColor="@color/streak_widget_secondary" android:maxLines="2" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="16dp">
    <TextView android:id="@+id/streak_best" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🏆 0" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/streak_widget_text" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/streak_best_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bestLabel" android:textSize="12sp" android:textColor="@color/streak_widget_secondary" android:maxLines="2" />
    <TextView android:id="@+id/streak_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/startLabel" android:textSize="12sp" android:textColor="@color/streak_widget_accent" android:maxLines="2" android:visibility="visible" />
    </LinearLayout>
</LinearLayout>
