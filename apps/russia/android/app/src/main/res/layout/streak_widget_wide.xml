<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/streak_root"
    android:background="@drawable/streak_widget_background"
    android:clipToOutline="true"
    android:importantForAccessibility="yes">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/streak_rays"
                android:layout_marginStart="-32dp"
                android:layout_marginTop="-48dp"
                android:layout_marginBottom="-58dp"
                android:src="@drawable/streak_widget_rays"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"/>
            <!-- The flame ends at the middle of the row for both single- and multi-digit totals. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="2dp">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/streak_flame"
                        android:layout_width="32dp"
                        android:layout_height="42dp"
                        android:layout_gravity="end|center_vertical"
                        android:src="@drawable/streak_widget_flame"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:id="@+id/streak_current"
                    android:text="7"
                    android:textColor="#FFFFFF"
                    android:textSize="51sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7dp"
                    android:autoSizeMaxTextSize="51dp"
                    android:autoSizeStepGranularity="1dp"
                    android:maxLines="1"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:id="@+id/streak_trophy"
                    android:src="@drawable/streak_widget_trophy"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:id="@+id/streak_best"
                    android:text="21"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7dp"
                    android:autoSizeMaxTextSize="14dp"
                    android:autoSizeStepGranularity="1dp"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="4dp"
                    android:maxWidth="55dp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:id="@+id/streak_week"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="7dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:background="@drawable/streak_widget_week_surface">
</LinearLayout>
    </LinearLayout>
</FrameLayout>
