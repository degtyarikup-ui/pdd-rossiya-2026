<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/streak_widget_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/streak_flame"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:src="@drawable/streak_widget_flame"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/streak_current"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="0"
                android:textSize="32sp"
                android:textColor="@color/streak_widget_text"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="5sp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeStepGranularity="1sp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/streak_label"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/currentLabel"
            android:textSize="12sp"
            android:textColor="@color/streak_widget_secondary"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/streak_trophy"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:src="@drawable/streak_widget_trophy"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/streak_best"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="0"
                android:textSize="20sp"
                android:textColor="@color/streak_widget_text"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="5sp"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>
        <TextView
            android:id="@+id/streak_best_label"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/bestLabel"
            android:textSize="12sp"
            android:textColor="@color/streak_widget_secondary"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:layout_weight="1" />
    </LinearLayout>
    <TextView
        android:id="@+id/streak_status"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="@string/startLabel"
        android:textSize="12sp"
        android:textColor="@color/streak_widget_accent"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:gravity="center_vertical"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5sp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />
</LinearLayout>
