<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/streak_root"
    android:background="@drawable/streak_widget_background"
    android:clipToOutline="true"
    android:importantForAccessibility="yes">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:gravity="center">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:clipChildren="false">
            <!-- Equal scaling preserves the flare. Its overscan follows the flame’s padded center. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/streak_rays"
                android:alpha="0.85"
                android:src="@drawable/streak_widget_rays"
                android:importantForAccessibility="no"
                android:layout_marginTop="-42dp"
                android:layout_marginBottom="-63dp"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/streak_flame"
                android:src="@drawable/streak_widget_flame"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:paddingTop="22dp"
                android:paddingBottom="1dp"/>
        </FrameLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/streak_current"
            android:text="7"
            android:textColor="#FFFFFF"
            android:textSize="51sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7dp"
            android:autoSizeMaxTextSize="51dp"
            android:autoSizeStepGranularity="1dp"
            android:maxLines="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-black"
            android:importantForAccessibility="no"
            android:layout_weight="0.8"
            android:paddingBottom="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp">
        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:id="@+id/streak_trophy"
            android:src="@drawable/streak_widget_trophy"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="#FFFFFF"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:id="@+id/streak_best"
            android:text="21"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7dp"
            android:autoSizeMaxTextSize="14dp"
            android:autoSizeStepGranularity="1dp"
            android:maxLines="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-black"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"
            android:maxWidth="55dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/streak_status_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="11dp"
        android:layout_marginBottom="11dp"
        android:importantForAccessibility="no"
        android:src="@drawable/streak_widget_check"/>
</FrameLayout>
