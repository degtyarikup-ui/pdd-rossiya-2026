 "text": {
  "ru": {
   "ticket": "Билет 24 · Вопрос 15",
   "title": "В каком случае Вы обязаны уступить дорогу пешеходам?",
   "options": [
    "Только при повороте налево",
    "Только при повороте направо",
    "В обоих случаях"
   ],
   "explanation": "При проезде любых перекрёстков с поворотом налево или направо водитель обязан уступить дорогу пешеходам, переходящим проезжую часть дороги, на которую он поворачивает.(Пункт 13.1 ПДД)",
   "pddRule": "п. 13.1"
  },
  "en": {
   "ticket": "Ticket 24 · Question 15",
   "title": "When are you required to give way to pedestrians?",
   "options": [
    "Only when turning left",
    "Only when turning right",
    "In both cases"
   ],
   "explanation": "When driving through any intersections with a left or right turn, the driver is obliged to give way to pedestrians crossing the roadway onto which he is turning. (Clause 13.1 of the Traffic Regulations)",
   "pddRule": "п. 13.1"
  },
  "kk": {
   "ticket": "24-билет · 15-сұрақ",
   "title": "Сіз жаяу жүргіншілерге қашан жол беруге міндеттісіз?",
   "options": [
    "Тек солға бұрылғанда",
    "Тек оңға бұрылғанда",
    "Екі жағдайда да"
   ],
   "explanation": "Солға немесе оңға бұрылысы бар кез келген қиылыстар арқылы жүру кезінде жүргізуші өзі бұрылатын жол бөлігін кесіп өтетін жаяу жүргіншілерге жол беруге міндетті. (Жол қозғалысы ережесінің 13.1 тармағы)",
   "pddRule": "п. 13.1"
  }
 },
