 "text": {
  "ru": {
   "ticket": "Билет 5 · Вопрос 1",
   "title": "Сколько проезжих частей имеет данная дорога?",
   "options": [
    "Одну",
    "Две",
    "Четыре"
   ],
   "explanation": "Данная горизонтальная разметка 1.3 не делит дорогу на проезжие части. Поэтому в изображенной ситуации дорога имеет четыре полосы движения и одну проезжую часть.(Пункт 1.2 ПДД термин «Разделительная полоса»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 5 · Question 1",
   "title": "How many carriageways does this road have?",
   "options": [
    "One",
    "Two",
    "Four"
   ],
   "explanation": "This horizontal marking 1.3 does not divide the road into carriageways. Therefore, in the situation depicted, the road has four lanes and one carriageway. (Clause 1.2 of the traffic rules, the term “Dividing strip”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "5-билет · 1-сұрақ",
   "title": "Бұл жолдың қанша жүріс бөлігі бар?",
   "options": [
    "Бір",
    "Екі",
    "Төрт"
   ],
   "explanation": "Бұл көлденең таңбалау 1.3 жолды жүріс бөлігіне бөлмейді. Сондықтан, бейнеленген жағдайда жолдың төрт жолағы және бір жүріс бөлігі бар. (Жол қозғалысы ережесінің 1.2 тармағы, «Бөлу жолағы» термині)",
   "pddRule": ""
  }
