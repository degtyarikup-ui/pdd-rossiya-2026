 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 15 · Вопрос 15",
   "title": "Кому Вы должны уступить дорогу при повороте налево?",
   "options": [
    "Только автобусу",
    "Только легковому автомобилю",
    "Никому"
   ],
   "explanation": "Перекрёсток неравнозначный. Главная дорога меняет направление. Транспортные средства, находящиеся на главной дороге, имеют преимущество, между собой руководствуются «правилом правой руки». У Вас помеха справа, уступаете автобусу. Легковой автомобиль проедет последним, так как находится на второстепенной дороге.(Пункты 13.9, 13.10, 13.11 ПДД)",
   "pddRule": "п. 13.9"
  },
  "en": {
   "ticket": "Ticket 15 · Question 15",
   "title": "Who should you give way to when turning left?",
   "options": [
    "Only by bus",
    "Passenger car only",
    "Nobody"
   ],
   "explanation": "The intersection is unequal. The main road changes direction. Vehicles on the main road have priority and are guided by the “right-hand rule” among themselves. There is an obstacle on your right, you give way to the bus. The passenger car will pass last, as it is on a secondary road. (Clause 13.9, 13.10, 13.11 Traffic Regulations)",
   "pddRule": "п. 13.9"
  },
  "kk": {
   "ticket": "15-билет · 15-сұрақ",
   "title": "Солға бұрылғанда кімге жол беру керек?",
   "options": [
    "Тек автобусқа",
    "Тек жеңіл автомобильге",
    "Ешкім"
   ],
   "explanation": "Қиылысу тең емес. Негізгі жол бағытын өзгертеді. Негізгі жолдағы көліктер басымдыққа ие және өз араларында «оң қол ережесін» басшылыққа алады. Оң жағыңызда кедергі бар, автобусқа жол бересіз. Жеңіл автомобиль қосалқы жолда болғандықтан, ең соңында өтеді. (Жол қозғалысы ережесінің 13.9, 13.10, 13.11 тармақтары)",
   "pddRule": "п. 13.9"
  }
 },
