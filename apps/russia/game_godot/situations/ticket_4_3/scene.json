  "ru": {
   "ticket": "Билет 4 · Вопрос 3",
   "title": "Какой из указанных знаков распространяет свое действие только на ту полосу, над которой он установлен?",
   "options": [
    "Только А",
    "Только Б",
    "Б и В"
   ],
   "explanation": "Знак с табличкой 8.14 «Полоса движения» («А»), указывающей полосу движения, на которую распространяется действие знака или светофора.(«Дорожные знаки»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 4 · Question 3",
   "title": "Which of the following signs applies only to the lane over which it is installed?",
   "options": [
    "Only А",
    "Only Б",
    "Б and В"
   ],
   "explanation": "A sign with a sign 8.14 “Traffic Lane” (“А”) indicating the traffic lane covered by the sign or traffic light. (“Road Signs”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "4-билет · 3-сұрақ",
   "title": "Төмендегі белгілердің қайсысы тек ол орнатылған жолаққа қатысты?",
   "options": [
    "Тек А",
    "Тек Б",
    "Б және В"
   ],
   "explanation": "8.14 «Жолақ» тақтайшасы («А») бар белгі қозғалыс жолағын көрсетеді, оған белгінің немесе бағдаршамның әрекеті қолданылады. («Жол белгілері»)",
   "pddRule": ""
  }
