 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 22 · Вопрос 14",
   "title": "В каком случае Вы должны уступить дорогу трамваю?",
   "options": [
    "При повороте налево",
    "При движении прямо",
    "В обоих перечисленных случаях"
   ],
   "explanation": "Перекрёсток равнозначный. Трамвай в равнозначных условиях имеет преимущество перед безрельсовыми транспортными средствами. Вы уступаете дорогу в обоих перечисленных случаях.(Пункт 13.11 ПДД)",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 22 · Question 14",
   "title": "In what case should you give way to a tram?",
   "options": [
    "When turning left",
    "When driving straight",
    "In both of the above cases"
   ],
   "explanation": "The intersection is equal. Under equal conditions, a tram has an advantage over trackless vehicles. You give way in both of the listed cases. (Clause 13.11 of the traffic rules)",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "22-билет · 14-сұрақ",
   "title": "Қандай жағдайда трамвайға жол беру керек?",
   "options": [
    "Солға бұрылғанда",
    "Тікелей жүргізгенде",
    "Жоғарыда аталған екі жағдайда да"
   ],
   "explanation": "Қиылысу тең. Бірдей жағдайда трамвай рельссіз көліктерге қарағанда артықшылығы бар. Сіз аталған екі жағдайда да жол бересіз. (Жол қозғалысы ережелерінің 13.11 тармағы)",
   "pddRule": "п. 13.11"
  }
 },
