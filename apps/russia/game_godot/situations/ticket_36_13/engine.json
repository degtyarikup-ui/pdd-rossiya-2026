 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 36 · Вопрос 13",
   "title": "Вы намерены повернуть направо. Ваши действия?",
   "options": [
    "Дождетесь другого сигнала регулировщика",
    "Уступите дорогу легковому автомобилю, осуществляющему разворот",
    "Проедете перекресток первым"
   ],
   "explanation": "Со стороны вытянутой правой руки регулировщика безрельсовым транспортным средствам движение разрешается только направо. При этом разворачивающийся автомобиль, руководствуясь «правилом правой руки», уступает Вам дорогу.(Пункт 6.10 ПДД)",
   "pddRule": "п. 6.10"
  },
  "en": {
   "ticket": "Ticket 36 · Question 13",
   "title": "You intend to turn right. What are your actions?",
   "options": [
    "Wait for another signal from the traffic controller",
    "Give way to a car making a U-turn",
    "Pass the intersection first"
   ],
   "explanation": "From the side of the traffic controller's outstretched right hand, trackless vehicles are only allowed to move to the right. In this case, the turning car, guided by the “right-hand rule,” gives way to you. (Clause 6.10 of the traffic rules)",
   "pddRule": "п. 6.10"
  },
  "kk": {
   "ticket": "36-билет · 13-сұрақ",
   "title": "Сіз оңға бұрылғыңыз келеді. Сіздің әрекеттеріңіз қандай?",
   "options": [
    "Жол реттеушісінің басқа сигналын күтіңіз",
    "Бұрылыс жасап жатқан көлікке жол беріңіз",
    "Алдымен қиылыстан өтіңіз"
   ],
   "explanation": "Жол реттеушісінің созылған оң қолының бүйірінен рельссіз көліктерге тек оңға қарай қозғалуға рұқсат етіледі. Бұл жағдайда «оң қол ережесін» басшылыққа алатын бұрылып жатқан көлік сізге жол береді. (Жол қозғалысы ережелерінің 6.10 тармағы)",
   "pddRule": "п. 6.10"
  }
 },
