  "ru": {
   "ticket": "Билет 6 · Вопрос 8",
   "title": "Кто должен уступить дорогу при взаимном перестроении?",
   "options": [
    "Водитель легкового автомобиля",
    "Водитель грузового автомобиля",
    "Водителям следует действовать по взаимной договоренности"
   ],
   "explanation": "При одновременном перестроении водители руководствуются «правилом правой руки». Помеха справа у водителя грузовика. Он уступает дорогу.(Пункт 8.4 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 6 · Question 8",
   "title": "Who must give way when changing lanes?",
   "options": [
    "Car driver",
    "Truck driver",
    "Drivers should act by mutual agreement"
   ],
   "explanation": "When changing lanes at the same time, drivers are guided by the “right-hand rule.” The truck driver has an obstacle on his right. He gives way. (Clause 8.4 of traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "6-билет · 8-сұрақ",
   "title": "Жолақты ауыстырған кезде кім жол беруі керек?",
   "options": [
    "Жеңіл автомобиль жүргізушісі",
    "Жүк көлігінің жүргізушісі",
    "Жүргізушілер өзара келісім бойынша әрекет етуі керек"
   ],
   "explanation": "Жолақтарды бір уақытта ауыстырған кезде жүргізушілер «оң қол ережесін» басшылыққа алады. Жүк көлігі жүргізушісінің оң жағында кедергі бар. Ол жол береді. (Жол қозғалысы ережелерінің 8.4 тармағы)",
   "pddRule": ""
  }
