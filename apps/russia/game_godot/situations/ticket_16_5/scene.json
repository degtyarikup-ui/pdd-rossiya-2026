 "text": {
  "ru": {
   "ticket": "Билет 16 · Вопрос 5",
   "title": "Разрешена ли Вам остановка в этом месте?",
   "options": [
    "Разрешена",
    "Разрешена без заезда на тротуар",
    "Запрещена"
   ],
   "explanation": "Сплошная линия разметки 1.4 жёлтого цвета обозначает места, где запрещена остановка. Применяется самостоятельно или в сочетании со знаком 3.27 «Остановка запрещена». Действие её распространяется также на ту сторону дороги, где она нанесена. Прилегающий тротуар является частью стороны дороги. Остановка Вам на всей длине разметки запрещена.(«Горизонтальная разметка»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 16 · Question 5",
   "title": "Are you allowed to stop at this place?",
   "options": [
    "Allowed",
    "Allowed without entering the sidewalk",
    "Prohibited"
   ],
   "explanation": "The solid yellow marking line 1.4 indicates places where stopping is prohibited. Used alone or in combination with sign 3.27 “Stopping is prohibited.” Its effect also extends to the side of the road where it is applied. The adjacent sidewalk is part of the side of the road. You are prohibited from stopping along the entire length of the markings. (“Horizontal markings”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "16-билет · 5-сұрақ",
   "title": "Сізге осы жерде тоқтауға рұқсат бар ма?",
   "options": [
    "Рұқсат етілген",
    "Тротуарға кірмей-ақ рұқсат етіледі",
    "Тыйым салынған"
   ],
   "explanation": "Тұтас сары таңбалау сызығы 1.4 тоқтауға тыйым салынған жерлерді көрсетеді. Дербес немесе 3.27 «Тоқтауға тыйым салынады» белгісімен бірге қолданылады. Оның әсері ол қолданылатын жолдың жағына да таралады. Іргелес тротуар жол жиегінің бөлігі болып табылады. Сізге белгілердің бүкіл ұзындығы бойынша тоқтауға тыйым салынады. («Көлденең таңбалар»)",
   "pddRule": ""
  }
 },
