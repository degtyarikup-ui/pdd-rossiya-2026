 "text": {
  "ru": {
   "ticket": "Билет 40 · Вопрос 2",
   "title": "Вам разрешено продолжить движение на перекрёстке?",
   "options": [
    "Только прямо",
    "Прямо и налево",
    "Прямо и в обратном направлении",
    "В любом направлении"
   ],
   "explanation": "В случае установки знака 4.1.1 «Движение прямо» непосредственно перед пересечением проезжих частей движение разрешается только прямо.(«Дорожные знаки»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 40 · Question 2",
   "title": "Are you allowed to continue driving at the intersection?",
   "options": [
    "Just straight",
    "Straight and left",
    "Forward and backward",
    "In any direction"
   ],
   "explanation": "If sign 4.1.1 “Move straight ahead” is installed immediately before the intersection of roadways, traffic is only allowed straight ahead. (“Road signs”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "40-билет · 2-сұрақ",
   "title": "Сізге қиылыста көлікпен жүруді жалғастыруға рұқсат бар ма?",
   "options": [
    "Тек түзу",
    "Тіке және солға",
    "Тура және кері бағытта",
    "Кез келген бағытта"
   ],
   "explanation": "Егер 4.1.1 «Тіке жүріңіз» белгісі тікелей жолдардың қиылысына дейін орнатылса, қозғалысқа тек алға қарай ғана рұқсат етіледі. («Жол белгілері»)",
   "pddRule": ""
  }
