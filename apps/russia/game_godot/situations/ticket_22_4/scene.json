  "ru": {
   "ticket": "Билет 22 · Вопрос 4",
   "title": "Что означают эти дорожные знаки?",
   "options": [
    "Стоянка разрешена транспортным средствам оперативных служб",
    "Стоянка разрешена только с включенными габаритными огнями",
    "Стоянка разрешена в субботние, воскресные и праздничные дни"
   ],
   "explanation": "Табличка 8.5.1 «Субботние, воскресные и праздничные дни» указывает, что знак, с которым она применяется, действует только в вышеперечисленные дни.(«Дорожные знаки»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 22 · Question 4",
   "title": "What do these road signs mean?",
   "options": [
    "Parking is permitted for emergency services vehicles",
    "Parking is only permitted with the side lights on.",
    "Parking is permitted on Saturdays, Sundays and holidays"
   ],
   "explanation": "Table 8.5.1 “Saturdays, Sundays and holidays” indicates that the sign with which it is used is valid only on the above days. (“Road signs”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "22-билет · 4-сұрақ",
   "title": "Бұл жол белгілері нені білдіреді?",
   "options": [
    "Төтенше жағдайлар қызметінің көліктері үшін тұраққа рұқсат етіледі",
    "Тұраққа бүйірлік шамдар қосулы болғанда ғана рұқсат етіледі.",
    "Сенбі, жексенбі және мереке күндері тұраққа рұқсат етіледі"
   ],
   "explanation": "«Сенбі, жексенбі және мереке күндері» 8.5.1 тақтайшасында ол қолданылатын белгі тек жоғарыда көрсетілген күндерде ғана жарамды екендігі көрсетілген. («Жол белгілері»)",
   "pddRule": ""
