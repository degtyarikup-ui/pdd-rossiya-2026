 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 38 · Вопрос 14",
   "title": "При движении в каком направлении Вы обязаны уступить дорогу трамваю?",
   "options": [
    "Только налево",
    "Только прямо",
    "В обоих перечисленных"
   ],
   "explanation": "Перекрёсток равнозначный. Вы и трамвай находитесь в равнозначных условиях. В таком случае трамвай всегда имеет преимущество перед безрельсовыми транспортными средствами.(Пункт 13.11 ПДД)",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 38 · Question 14",
   "title": "When driving in which direction are you required to give way to a tram?",
   "options": [
    "Only left",
    "Just straight",
    "In both of the above"
   ],
   "explanation": "The intersection is equal. You and the tram are in equal conditions. In this case, the tram always has an advantage over trackless vehicles. (Clause 13.11 of the Traffic Regulations)",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "38-билет · 14-сұрақ",
   "title": "Қай бағытта жүргенде трамвайға жол беру керек?",
   "options": [
    "Тек солға",
    "Тек түзу",
    "Жоғарыда аталғандардың екеуінде де"
   ],
   "explanation": "Қиылысу тең. Сіз де, трамвай да бірдей жағдайдасыз. Бұл жағдайда трамвай әрқашан рельссіз көліктерден артықшылығы бар. (Жол қозғалысы ережесінің 13.11 тармағы)",
   "pddRule": "п. 13.11"
  }
 },
