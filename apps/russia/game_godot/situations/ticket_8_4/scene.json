 "text": {
  "ru": {
   "ticket": "Билет 8 · Вопрос 4",
   "title": "Можно ли Вам повернуть направо на этом перекрёстке?",
   "options": [
    "Можно",
    "Можно, если Вы проживаете или работаете на территории, расположенной справа от перекрестка",
    "Нельзя"
   ],
   "explanation": "Знак 6.8.2 «Тупик» указывает, что примыкающая дорога не имеет сквозного проезда. Каких-либо ограничений он не вводит. Повернуть направо Вам можно.(«Дорожные знаки»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 8 · Question 4",
   "title": "Can you turn right at this intersection?",
   "options": [
    "Can",
    "Yes, if you live or work in the area located to the right of the intersection",
    "It is forbidden"
   ],
   "explanation": "Sign 6.8.2 “Dead End” indicates that the adjacent road does not have a through passage. He does not introduce any restrictions. You can turn right. (“Road signs”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "8-билет · 4-сұрақ",
   "title": "Осы қиылыстан оңға бұрыла аласыз ба?",
   "options": [
    "Иә",
    "Иә, егер сіз қиылыстың оң жағында орналасқан ауданда тұрсаңыз немесе жұмыс істесеңіз",
    "Ол тыйым салынған"
   ],
   "explanation": "6.8.2 «Тұйық» белгісі іргелес жолдың өту жолы жоқ екенін көрсетеді. Ол ешқандай шектеулер енгізбейді. Оңға бұрыла аласыз. («Жол белгілері»)",
   "pddRule": ""
  }
