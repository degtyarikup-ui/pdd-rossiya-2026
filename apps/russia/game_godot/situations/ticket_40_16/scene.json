 "text": {
  "ru": {
   "ticket": "Билет 40 · Вопрос 16",
   "title": "Можно ли Вам въехать на железнодорожный переезд?",
   "options": [
    "Можно",
    "Можно, если отсутствует приближающийся поезд",
    "Нельзя"
   ],
   "explanation": "Водитель грузовика остановился, чтобы уступить дорогу. Выехав на железнодорожный переезд, Вы будете вынуждены на нём остановиться, дожидаясь освобождения места за переездом. Выезд на железнодорожный переезд в такой ситуации запрещён.(Пункт 15.3 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 40 · Question 16",
   "title": "Can you enter a railway crossing?",
   "options": [
    "Can",
    "Possible if there is no approaching train",
    "It is forbidden"
   ],
   "explanation": "The truck driver stopped to give way. Having arrived at a railway crossing, you will be forced to stop there, waiting for the space behind the crossing to become free. Traveling to a railway crossing in such a situation is prohibited. (Clause 15.3 of traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "40-билет · 16-сұрақ",
   "title": "Сіз темір жол өткеліне кіре аласыз ба?",
   "options": [
    "Иә",
    "Жақындап келе жатқан пойыз болмаса, рұқсат етіледі.",
    "Ол тыйым салынған"
   ],
   "explanation": "Жүк көлігінің жүргізушісі жол беру үшін тоқтады. Темір жол өткеліне келген соң, сіз өткелдің артындағы кеңістіктің босағанын күтіп, сол жерде тоқтауға мәжбүр боласыз. Мұндай жағдайда темір жол өткеліне баруға тыйым салынады. (Жол қозғалысы ережелерінің 15.3 тармағы)",
   "pddRule": ""
  }
 },
