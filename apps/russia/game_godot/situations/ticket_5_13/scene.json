 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 5 · Вопрос 13",
   "title": "Вы намерены развернуться. Ваши действия?",
   "options": [
    "Проедете перекресток первым",
    "Выполните разворот, уступив дорогу легковому автомобилю",
    "Дождетесь, когда регулировщик опустит правую руку"
   ],
   "explanation": "Перекрёсток регулируемый. Правая рука регулировщика вытянута вперёд. Со стороны левого бока транспортные средства могут продолжить движение в любом направлении, соблюдая правила расположения транспортных средств на проезжей части.Производя разворот из крайней левой полосы, у Вас будет помеха справа. Вы уступите дорогу легковому автомобилю, поворачивающему направо. (Пункты 6.10, 13.4 ПДД)",
   "pddRule": "п. 13.4"
  },
  "en": {
   "ticket": "Ticket 5 · Question 13",
   "title": "You intend to turn around. What are your actions?",
   "options": [
    "Pass the intersection first",
    "Make a U-turn to give way to a car",
    "Wait until the traffic controller lowers his right hand"
   ],
   "explanation": "The intersection is controlled. The traffic controller's right arm is extended forward. From the left side, vehicles can continue moving in any direction, observing the rules for the location of vehicles on the roadway. When making a U-turn from the leftmost lane, you will have an obstacle on the right. You will give way to a car turning right. (Clause 6.10, 13.4 of traffic rules)",
   "pddRule": "п. 13.4"
  },
  "kk": {
   "ticket": "5-билет · 13-сұрақ",
   "title": "Айналуға ниетіңіз бар. Сіздің әрекеттеріңіз қандай?",
   "options": [
    "Алдымен қиылыстан өтіңіз",
    "Жеңіл автомобильге жол беріп, кері бұрылыңыз",
    "Жол реттеушісі оң қолын түсіргенше күтіңіз"
   ],
   "explanation": "Қиылыс реттелетін. Жол реттеушісінің оң қолы алға қарай созылған. Сол жақтан көліктер жолдың жүру бөлігінде көлік құралдарын орналастыру ережелерін сақтай отырып, кез келген бағытта қозғала алады. Ең сол жақ жолақтан кері бұрылу кезінде оң жақта кедергі болады. Сіз оңға бұрылатын көлікке жол бересіз. (Жол қозғалысы ережелерінің 6.10, 13.4 тармағы)",
   "pddRule": "п. 13.4"
  }
 },
