   "ru": {
    "ticket": "Билет 3 · Вопрос 16",
    "title": "Кто из водителей нарушил правила остановки?",
    "options": [
     "Только водитель легкового автомобиля",
     "Только водитель грузового автомобиля",
     "Оба"
    ],
    "explanation": "На автомагистрали остановка и стоянка вне мест, специально отведённых и обозначенных соответствующими знаками, запрещена. Оба водителя нарушают правила.(«Дорожные знаки», пункты 12.1, 16.1 ПДД)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 3 · Question 16",
    "title": "Which driver violated the stopping rules?",
    "options": [
     "Car driver only",
     "Truck driver only",
     "Both"
    ],
    "explanation": "On the highway, stopping and parking outside of specially designated areas and marked with appropriate signs is prohibited. Both drivers violate the rules. (“Road signs”, paragraphs 12.1, 16.1 of the traffic rules)",
    "pddRule": ""
   },
   "kk": {
    "ticket": "3-билет · 16-сұрақ",
    "title": "Қай жүргізуші тоқтау ережесін бұзды?",
    "options": [
     "Тек көлік жүргізушісі",
     "Тек жүк көлігінің жүргізушісі",
     "Екеуі де"
    ],
    "explanation": "Автомагистральде арнайы бөлінген және тиісті белгілермен белгіленген жерлерден тыс жерде тоқтап тұруға және тұрақтауға тыйым салынады. Екі жүргізуші де ереже бұзады. («Жол белгілері», Жол қозғалысы ережелерінің 12.1, 16.1-тармақтары)",
    "pddRule": ""
   }
