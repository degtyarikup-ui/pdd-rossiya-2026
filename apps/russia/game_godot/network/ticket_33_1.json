 "question": {
  "text": {
   "ru": {
    "ticket": "Билет 33 · Вопрос 1",
    "title": "Какой маневр намеревается выполнить водитель легкового автомобиля?",
    "options": [
     "Обгон",
     "Перестроение с дальнейшим опережением",
     "Объезд"
    ],
    "explanation": "Водитель легкового автомобиля осуществляет «перестроение» в параллельный ряд и дальнейшее «опережение» - движение транспортного средства со скоростью большей скорости попутного транспортного средства.(Пункт 1.2 ПДД термины «Перестроение», «Опережение»)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 33 · Question 1",
    "title": "What maneuver does the driver of a car intend to perform?",
    "options": [
     "Overtaking",
     "Rebuild further ahead",
     "Detour"
    ],
    "explanation": "The driver of a passenger car “changes lanes” into a parallel lane and further “advances” - the vehicle moves at a speed greater than the speed of the same-direction vehicle (Clause 1.2 of the Traffic Regulations, the terms “Lane change” and “Advancing”).",
    "pddRule": ""
   },
   "kk": {
    "ticket": "33-билет · 1-сұрақ",
    "title": "Көлік жүргізушісі қандай маневр жасамақшы?",
    "options": [
     "Басып озу",
     "Жолақты ауыстырып, одан әрі басып озу",
     "Айналып өту"
    ],
    "explanation": "Жеңіл автомобиль жүргізушісі параллель жолаққа «жолақты ауыстырады» және одан әрі «басып озады» - бұл өтіп бара жатқан көлік құралының жылдамдығынан жоғары жылдамдықпен қозғалу. (Жол қозғалысы ережесінің 1.2-тармағы, «Перестроение», «Опережение» терминдері)",
    "pddRule": ""
   }
