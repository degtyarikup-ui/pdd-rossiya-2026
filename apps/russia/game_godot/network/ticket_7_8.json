   "ru": {
    "ticket": "Билет 7 · Вопрос 8",
    "title": "Обязан ли водитель легкового автомобиля уступить дорогу водителю грузового автомобиля?",
    "options": [
     "Обязан",
     "Обязан, если водитель грузового автомобиля начнет смещаться вправо",
     "Не обязан"
    ],
    "explanation": "Водитель легкового автомобиля «хозяин» полосы, поэтому и уступать не обязан.(Пункт 8.4 ПДД)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 7 · Question 8",
    "title": "Is a passenger car driver required to give way to a truck driver?",
    "options": [
     "Obliged",
     "Obligated if the truck driver begins to move to the right",
     "Not obliged"
    ],
    "explanation": "The driver of a passenger car is the “owner” of the lane, and therefore is not obliged to yield. (Clause 8.4 of the Traffic Regulations)",
    "pddRule": ""
   },
   "kk": {
    "ticket": "7-билет · 8-сұрақ",
    "title": "Автокөлік жүргізушісі жүк көлігінің жүргізушісіне жол беруі керек пе?",
