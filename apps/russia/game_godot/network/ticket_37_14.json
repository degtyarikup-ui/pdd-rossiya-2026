 "question": {
  "text": {
   "ru": {
    "ticket": "Билет 37 · Вопрос 14",
    "title": "При движении в каком направлении Вы будете иметь преимущество?",
    "options": [
     "Только при повороте направо",
     "Только при повороте налево",
     "В любом направлении из перечисленных"
    ],
    "explanation": "Перекрёсток равнозначный. Водители руководствуются «правилом правой руки». У Вас помехи справа нет, в любом направлении из перечисленных. Проезжаете перекрёсток первым.(Пункт 13.11 ПДД)",
    "pddRule": "п. 13.11"
   },
   "en": {
    "ticket": "Ticket 37 · Question 14",
    "title": "When moving in which direction will you have an advantage?",
    "options": [
     "Only when turning right",
     "Only when turning left",
     "In any direction listed"
    ],
    "explanation": "The intersection is equal. Drivers are guided by the “right hand rule”. You have no interference on the right, in any of the directions listed. Pass the intersection first. (Clause 13.11 of traffic rules)",
    "pddRule": "п. 13.11"
   },
   "kk": {
    "ticket": "37-билет · 14-сұрақ",
    "title": "Қай бағытта қозғалғанда сіз артықшылыққа ие боласыз?",
    "options": [
     "Тек оңға бұрылғанда",
     "Тек солға бұрылғанда",
     "Тізімде көрсетілген кез келген бағытта"
    ],
    "explanation": "Қиылысу тең. Жүргізушілер «оң қол ережесін» басшылыққа алады. Жауаптарда көрсетілген бағыттардың ешқайсында да оң жақтан кедергі жоқ. Алдымен қиылыстан өтіңіз. (Жол қозғалысы ережелерінің 13.11 тармағы)",
    "pddRule": "п. 13.11"
   }
