 "question": {
  "text": {
   "ru": {
    "ticket": "Билет 38 · Вопрос 5",
    "title": "Разрешается ли Вам остановка в этом месте?",
    "options": [
     "Разрешается",
     "Разрешается только с заездом на тротуар",
     "Разрешается, если при этом не будут созданы помехи маршрутным транспортным средствам",
     "Запрещается"
    ],
    "explanation": "Прерывистая жёлтая линия разметки 1.10 обозначает места, где запрещена стоянка. С 1 марта 2023 года применяется только самостоятельно. Ничего противоречащего остановке нет, т.е. она разрешается. («Горизонтальная разметка»)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 38 · Question 5",
    "title": "Are you allowed to stop at this place?",
    "options": [
     "Allowed",
     "Allowed only with entry onto the sidewalk",
     "Permitted if it does not interfere with route vehicles",
     "Prohibited"
    ],
    "explanation": "The intermittent yellow line 1.10 indicates places where parking is prohibited. From March 1, 2023, it is applied only independently. There is nothing contradicting the stop, i.e. it is allowed. (“Horizontal markings”)",
    "pddRule": ""
   },
   "kk": {
    "ticket": "38-билет · 5-сұрақ",
    "title": "Сізге осы жерде тоқтауға рұқсат бар ма?",
    "options": [
     "Рұқсат етілген",
     "Тротуарға кіру арқылы ғана рұқсат етіледі",
     "Маршруттық көліктерге кедергі келтірмейтін болса, рұқсат етіледі",
     "Тыйым салынған"
    ],
    "explanation": "Үзік сары таңбалау сызығы 1.10 тұраққа тыйым салынған орындарды көрсетеді. 2023 жылдың 1 наурызынан бастап оны тек дербес қолдануға болады. Тоқтауға қарсы ештеңе жоқ, яғни тоқтауға рұқсат етіледі. («Көлденең таңбалау»)",
    "pddRule": ""
   }
