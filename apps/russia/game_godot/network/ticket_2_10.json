   "ru": {
    "ticket": "Билет 2 · Вопрос 10",
    "title": "В каких случаях разрешается наезжать на прерывистые линии разметки, разделяющие проезжую часть на полосы движения?",
    "options": [
     "Только если на дороге нет других транспортных средств",
     "Только при движении в темное время суток",
     "Только при перестроении",
     "Во всех перечисленных случаях"
    ],
    "explanation": "Наезжать на прерывистые линии разметки разрешается лишь при перестроении.(Пункт 9.7 ПДД)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 2 · Question 10",
    "title": "In what cases is it permissible to drive over broken marking lines dividing the roadway into traffic lanes?",
    "options": [
     "Only if there are no other vehicles on the road",
     "Only when driving in the dark",
     "Only when changing lanes",
     "In all of the above cases"
    ],
    "explanation": "It is allowed to drive over broken marking lines only when changing lanes. (Clause 9.7 of the Traffic Regulations)",
    "pddRule": ""
   },
   "kk": {
    "ticket": "2-билет · 10-сұрақ",
    "title": "Қандай жағдайларда жол бөлігін қозғалыс жолақтарына бөлетін үзілген таңбалау сызықтары арқылы жүруге рұқсат етіледі?",
    "options": [
     "Жолда басқа көліктер болмаса ғана",
     "Тек қараңғыда көлік жүргізгенде",
     "Тек жолақты ауыстырған кезде",
     "Жоғарыда аталған барлық жағдайларда"
    ],
    "explanation": "Таңбалаудың үзік сызықтарын басып өтуге тек жолақты ауыстырған кезде рұқсат етіледі. (Жол қозғалысы ережесінің 9.7 тармағы)",
