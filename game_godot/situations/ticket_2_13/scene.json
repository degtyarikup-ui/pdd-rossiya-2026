 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 2 · Вопрос 13",
   "title": "Вы намерены повернуть налево. Кому Вы должны уступить дорогу?",
   "options": [
    "Только пешеходам",
    "Только автобусу",
    "Автобусу и пешеходам"
   ],
   "explanation": "Перекрёсток регулируемый. Знаки приоритета «не работают». При повороте налево Вы уступаете автобусу, движущемуся прямо со встречного направления, и пешеходам, переходящим проезжую часть дороги, на которую Вы поворачиваете.(Пункты 13.1, 13.3, 13.4 ПДД).",
   "pddRule": "п. 13.4"
  },
  "en": {
   "ticket": "Ticket 2 · Question 13",
   "title": "You intend to turn left. Who should you give way to?",
   "options": [
    "Pedestrians only",
    "Only by bus",
    "Bus and pedestrians"
   ],
   "explanation": "The intersection is controlled. Priority signs don't work. When turning left, you give way to a bus moving straight from the opposite direction, and to pedestrians crossing the roadway you are turning onto (Clause 13.1, 13.3, 13.4 of the Traffic Regulations).",
   "pddRule": "п. 13.4"
  },
  "kk": {
   "ticket": "2-билет · 13-сұрақ",
   "title": "Сіз солға бұрылғыңыз келеді. Кімге жол беру керек?",
   "options": [
    "Тек жаяу жүргіншілер",
    "Тек автобусқа",
    "Автобус және жаяу жүргіншілер"
   ],
   "explanation": "Қиылыс реттелетін. Басымдық белгілері жұмыс істемейді. Солға бұрылу кезінде сіз қарама-қарсы бағыттан тура келе жатқан автобусқа және сіз бұрылып жатқан жол бөлігін кесіп өтіп жатқан жаяу жүргіншілерге жол бересіз (Жол қозғалысы ережесінің 13.1, 13.3, 13.4-тармақтары).",
   "pddRule": "п. 13.4"
  }
 },
