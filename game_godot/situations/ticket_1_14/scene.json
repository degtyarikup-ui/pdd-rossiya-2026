 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 1 · Вопрос 14",
   "title": "Вы намерены проехать перекресток в прямом направлении. Кому Вы должны уступить дорогу?",
   "options": [
    "Обоим трамваям",
    "Только трамваю А",
    "Только трамваю Б",
    "Никому"
   ],
   "explanation": "Перекрёсток равнозначный. Трамваи в равнозначных условиях имеют преимущество перед безрельсовыми транспортными средствами. Между собой руководствуются «правилом правой руки». Помеха справа у трамвая «А». Соответственно первым проезжает трамвай «Б», за ним «А», Вы последним.(Пункт 13.11 ПДД)",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 1 · Question 14",
   "title": "You intend to drive straight through the intersection. Who should you give way to?",
   "options": [
    "Both trams",
    "Only tram А",
    "Only tram Б",
    "Nobody"
   ],
   "explanation": "The intersection is equal. Under equal conditions, trams have an advantage over trackless vehicles. They are guided by the “right hand rule” among themselves. There is an obstacle on the right side of tram \"А\". Accordingly, tram “Б” passes first, followed by “А”, you are the last. (Clause 13.11 of the Traffic Regulations)",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "1-билет · 14-сұрақ",
   "title": "Сіз қиылыстан тура көлікпен жүрмексіз. Кімге жол беру керек?",
   "options": [
    "Екі трамвай да",
    "Тек трамвай А",
    "Тек Б трамвайы",
    "Ешкім"
   ],
   "explanation": "Қиылысу тең. Бірдей жағдайда трамвайлар рельссіз көліктерге қарағанда артықшылыққа ие. Олар өзара «оң қол ережесін» басшылыққа алады. «А» трамвайының оң жағында кедергі бар. Тиісінше, бірінші трамвай «Б» өтеді, одан кейін «А», сіз соңғысыз. (Жол қозғалысы ережесінің 13.11 тармағы)",
   "pddRule": "п. 13.11"
  }
 },
