 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 13 · Вопрос 14",
   "title": "Кто из водителей, выполняющих поворот, должен уступить дорогу пешеходам?",
   "options": [
    "Только водитель легкового автомобиля",
    "Только водитель грузового автомобиля",
    "Оба"
   ],
   "explanation": "При повороте направо или налево при проезде перекрёстков, как регулируемых, так и нерегулируемых, водитель обязан уступить дорогу пешеходам, переходящим проезжую часть дороги, на которую он поворачивает. Оба водителя уступают дорогу пешеходам.(Пункт 13.1 ПДД)",
   "pddRule": "п. 13.1"
  },
  "en": {
   "ticket": "Ticket 13 · Question 14",
   "title": "Which driver making a turn must give way to pedestrians?",
   "options": [
    "Car driver only",
    "Truck driver only",
    "Both"
   ],
   "explanation": "When turning right or left when passing through intersections, both regulated and unregulated, the driver is obliged to give way to pedestrians crossing the roadway onto which he is turning. Both drivers give way to pedestrians. (Clause 13.1 of traffic rules)",
   "pddRule": "п. 13.1"
  },
  "kk": {
   "ticket": "13-билет · 14-сұрақ",
   "title": "Бұрылыс жасаған қай жүргізуші жаяу жүргіншілерге жол беруі керек?",
   "options": [
    "Тек көлік жүргізушісі",
    "Тек жүк көлігінің жүргізушісі",
    "Екеуі де"
   ],
   "explanation": "Реттелетін және реттелмейтін қиылыстар арқылы өткен кезде оңға немесе солға бұрылу кезінде жүргізуші өзі бұрылатын жол бөлігін кесіп өтетін жаяу жүргіншілерге жол беруге міндетті. Екі жүргізуші де жаяу жүргіншілерге жол береді. (Жол қозғалысы ережелерінің 13.1 тармағы)",
   "pddRule": "п. 13.1"
  }
 },
