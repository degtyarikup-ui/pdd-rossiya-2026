 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 28 · Вопрос 14",
   "title": "Вы должны уступить дорогу грузовому автомобилю:",
   "options": [
    "Только при движении прямо",
    "Только при повороте направо",
    "В обоих перечисленных случаях"
   ],
   "explanation": "Перекрёсток равнозначный. Водители руководствуются «правилом правой руки». У Вас помеха справа будет только при движении прямо - Вы уступаете дорогу грузовому автомобилю. При повороте направо помеха справа отсутствует.(Пункт 13.11 ПДД)",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 28 · Question 14",
   "title": "You must give way to a truck:",
   "options": [
    "Only when driving straight",
    "Only when turning right",
    "In both of the above cases"
   ],
   "explanation": "The intersection is equal. Drivers are guided by the “right hand rule”. You will have an obstacle on the right only when driving straight - you are giving way to a truck. When turning right, there is no obstacle on the right. (Clause 13.11 of the Traffic Regulations)",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "28-билет · 14-сұрақ",
   "title": "Жүк көлігіне жол беру керек:",
   "options": [
    "Тек түзу жүргізгенде",
    "Тек оңға бұрылғанда",
    "Жоғарыда аталған екі жағдайда да"
   ],
   "explanation": "Қиылысу тең. Жүргізушілер «оң қол ережесін» басшылыққа алады. Тікелей жүріп келе жатқанда ғана оң жақта кедергі болады - сіз жүк көлігіне жол бересіз. Оңға бұрылғанда оң жақта ешқандай кедергі болмайды. (Жол қозғалысы ережесінің 13.11 тармағы)",
   "pddRule": "п. 13.11"
  }
 },
