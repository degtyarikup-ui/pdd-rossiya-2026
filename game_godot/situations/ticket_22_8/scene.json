 "text": {
  "ru": {
   "ticket": "Билет 22 · Вопрос 8",
   "title": "По какой траектории Вам можно выполнить поворот налево?",
   "options": [
    "Только по А",
    "Только по Б",
    "По любой из указанных"
   ],
   "explanation": "Поворачивая при выезде с пересечения проезжих частей, Вы не должны оказаться на стороне встречного движения. Поворот налево следует произвести по траектории «Б».(Пункт 8.6 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 22 · Question 8",
   "title": "On what trajectory can you make a left turn?",
   "options": [
    "Only on А",
    "Only on Б",
    "For any of these"
   ],
   "explanation": "Turning at the exit from the intersection of carriageways, you should not be on the side of oncoming traffic. Turn to the left along the trajectory \"Б\".(Clause 8.6 of the Traffic Rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "22-билет · 8-сұрақ",
   "title": "Солға бұрылу үшін қандай траекторияны қолдануға болады?",
   "options": [
    "Тек А",
    "Тек Б",
    "Жоғарыда аталғандардың кез келгені бойынша"
   ],
   "explanation": "Жолдардың қиылысынан шыққан кезде бұрылыс кезінде сіз қарсы келе жатқан көліктің жағына шықпауыңыз керек. Солға бұрылу «Б» траекториясы бойынша жасалуы керек. (Жол қозғалысы ережесінің 8.6 тармағы)",
   "pddRule": ""
  }
