 "text": {
  "ru": {
   "ticket": "Билет 17 · Вопрос 8",
   "title": "Разрешено ли Вам выполнить поворот направо в данной ситуации?",
   "options": [
    "Разрешено",
    "Разрешено, если при этом не будут созданы помехи транспортным средствам, движущимся с других направлений",
    "Запрещено"
   ],
   "explanation": "Вы находитесь на левой полосе, с которой совершить поворот направо нельзя. Для поворота направо необходимо было заблаговременно перестроиться на правую полосу.(Пункты 8.5, 6.3 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 17 · Question 8",
   "title": "Are you allowed to make a right turn in this situation?",
   "options": [
    "Allowed",
    "Permitted if it does not interfere with vehicles moving from other directions",
    "Forbidden"
   ],
   "explanation": "You are in the left lane, from which you cannot turn right. To turn right, it was necessary to change lanes to the right lane in advance. (Clause 8.5, 6.3 of traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "17-билет · 8-сұрақ",
   "title": "Бұл жағдайда оңға бұруға рұқсат ете ме?",
   "options": [
    "Рұқсат етілген",
    "Басқа жақтан қозғалатын көліктерге кедергі келтірмейтін болса рұқсат етіледі",
    "Тыйым салынған"
   ],
   "explanation": "Сіз оңға бұрыла алмайтын сол жақтасыз. Оңға бұрылу үшін алдын ала оң жақ жолаққа жолақтарды өзгерту қажет болды. (Жол қозғалысы ережелерінің 8.5, 6.3-тармақтары)",
   "pddRule": ""
  }
 },
