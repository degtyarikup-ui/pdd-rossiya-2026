 "text": {
  "ru": {
   "ticket": "Билет 3 · Вопрос 8",
   "title": "Вам разрешено выполнить поворот направо:",
   "options": [
    "Только по траектории А",
    "Только по траектории Б",
    "По любой траектории из указанных"
   ],
   "explanation": "При повороте направо транспортное средство должно двигаться по возможности ближе к правому краю проезжей части. У Вас такая возможность есть, продолжаете движение по траектории «А».(Пункт 8.6 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 3 · Question 8",
   "title": "You are allowed to make a right turn:",
   "options": [
    "Only along trajectory А",
    "Only along trajectory Б",
    "Along any trajectory of the specified"
   ],
   "explanation": "When turning right, the vehicle should move as close as possible to the right edge of the roadway. You have such an opportunity, continue moving along trajectory “А”. (Clause 8.6 of traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "3-билет · 8-сұрақ",
   "title": "Оңға бұрылыс жасауға рұқсат етіледі:",
   "options": [
    "Тек А траекториясы бойынша",
    "Тек Б траекториясы бойынша",
    "Көрсетілген жолдардың кез келгенінде"
   ],
   "explanation": "Оңға бұрылған кезде көлік құралы жолдың оң жақ шетіне мүмкіндігінше жақын қозғалуы керек. Сізде мұндай мүмкіндік бар, «А» траекториясы бойынша қозғалуды жалғастырыңыз. (Жол қозғалысы ережелерінің 8.6 тармағы)",
   "pddRule": ""
  }
 },
