  "ru": {
   "ticket": "Билет 18 · Вопрос 5",
   "title": "В данной ситуации Вы:",
   "options": [
    "Должны остановиться у знака",
    "Должны остановиться у стоп-линии",
    "Можете при отсутствии других транспортных средств проехать перекрёсток без остановки"
   ],
   "explanation": "Знак 2.5 «Движение без остановки запрещено» установлен перед пересечением проезжих частей. При наличии стоп-линии (разметка 1.12) запрещается движение без остановки перед стоп-линией.(«Дорожные знаки», «Горизонтальная разметка»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 18 · Question 5",
   "title": "In this situation you:",
   "options": [
    "Must stop at the sign",
    "Must stop at the stop line",
    "If there are no other vehicles, you can drive through the intersection without stopping."
   ],
   "explanation": "Sign 2.5 “Driving without stopping is prohibited” is installed before the intersection of roadways. If there is a stop line (marking 1.12), driving without stopping in front of the stop line is prohibited. (“Road signs”, “Horizontal markings”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "18-билет · 5-сұрақ",
   "title": "Бұл жағдайда сіз:",
   "options": [
    "Белгіге тоқтау керек",
    "Тоқтау сызығында тоқтау керек",
    "Басқа көліктер болмаса, қиылыстан тоқтаусыз өтуге болады."
   ],
   "explanation": "2.5 «Тоқтамай көлік жүргізуге тыйым салынады» белгісі жолдардың қиылысына дейін орнатылады. Тоқтау сызығы болса (1.12 белгісі), тоқтау сызығының алдында тоқтамай жүруге тыйым салынады. («Жол белгілері», «Көлденең таңбалар»)",
   "pddRule": ""
  }
