 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 32 · Вопрос 14",
   "title": "Вы намерены развернуться. Ваши действия?",
   "options": [
    "Развернётесь первым",
    "Выедете на перекрёсток и, уступив дорогу легковому автомобилю, завершите разворот",
    "Будете действовать по взаимной договоренности с водителем легкового автомобиля"
   ],
   "explanation": "Перекрёсток равнозначный. При определении порядка проезда перекрёстка водители руководствуются «правилом правой руки». Во время разворота у Вас будет помеха справа, уступаете дорогу.(Пункт 13.11 ПДД)",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 32 · Question 14",
   "title": "You intend to turn around. What are your actions?",
   "options": [
    "Be the first to turn around",
    "Drive to the intersection and, giving way to a passenger car, complete a U-turn",
    "You will act by mutual agreement with the driver of the car"
   ],
   "explanation": "The intersection is equal. When determining the order of passage through an intersection, drivers are guided by the “right-hand rule.” During a U-turn, you will see an obstacle on the right, give way. (Clause 13.11 of traffic rules)",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "32-билет · 14-сұрақ",
   "title": "Айналуға ниетіңіз бар. Сіздің әрекеттеріңіз қандай?",
   "options": [
    "Бірінші болып бұрылыңыз",
    "Қиылысқа кіріп, жеңіл автомобильге жол беріп, кері бұрылуды аяқтаңыз",
    "Сіз көлік жүргізушісімен өзара келісім бойынша әрекет етесіз"
   ],
   "explanation": "Қиылысу тең. Жол қиылысынан өту тәртібін анықтау кезінде жүргізушілер «оң қол ережесін» басшылыққа алады. Бұрылыс кезінде сізде оң жақта кедергі болады, жол беріңіз. (Жол қозғалысы ережелерінің 13.11 тармағы)",
   "pddRule": "п. 13.11"
  }
 },
