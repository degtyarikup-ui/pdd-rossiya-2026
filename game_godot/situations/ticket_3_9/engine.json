 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 3 · Вопрос 9",
   "title": "Разрешается ли Вам выполнить разворот на перекрестке по указанной траектории?",
   "options": [
    "Разрешается",
    "Разрешается, если видимость дороги не менее 100 м",
    "Запрещается"
   ],
   "explanation": "Впереди перекрёсток. Прежде, чем совершить на нём поворот или разворот, необходимо было перестроиться на левую крайнюю полосу. Вы этого своевременно не сделали. Разворот по данной траектории является нарушением.(Пункты 8.5, 8.8 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 3 · Question 9",
   "title": "Are you allowed to make a U-turn at an intersection along the specified trajectory?",
   "options": [
    "Allowed",
    "Permitted if road visibility is at least 100 m",
    "Prohibited"
   ],
   "explanation": "There is an intersection ahead. Before making a turn or U-turn on it, it was necessary to change lanes to the left extreme lane. You didn't do this in a timely manner. A U-turn along this trajectory is a violation. (Clause 8.5, 8.8 of the Traffic Regulations)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "3-билет · 9-сұрақ",
   "title": "Көрсетілген траектория бойынша қиылыста кері бұрылыс жасауға рұқсат етілген бе?",
   "options": [
    "Рұқсат етілген",
    "Жолдың көрінуі кемінде 100 м болса рұқсат етіледі",
    "Тыйым салынған"
   ],
   "explanation": "Алда жол қиылысы бар. Бұрылыс немесе кері бұрылыс жасамас бұрын сол жақ шеткі жолаққа ауысу қажет болды. Сіз мұны дер кезінде жасаған жоқсыз. Бұл траектория бойынша кері бұрылу бұзушылық болып табылады. (Жол қозғалысы ережесінің 8.5, 8.8 тармақтары)",
   "pddRule": ""
  }
 },
