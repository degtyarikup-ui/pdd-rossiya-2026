 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 25 · Вопрос 14",
   "title": "При повороте направо Вы должны уступить дорогу:",
   "options": [
    "Только велосипедисту",
    "Только пешеходам",
    "Пешеходам и велосипедисту"
   ],
   "explanation": "При повороте направо или налево водитель обязан уступить дорогу пешеходам, лицам, использующим для передвижения СИМ и велосипедистам, пересекающим проезжую часть дороги, на которую он поворачивает.Это правило проезда перекрестков касается как регулируемых, так и нерегулируемых перекрестков.(Пункт 13.1 ПДД)",
   "pddRule": "п. 13.1"
  },
  "en": {
   "ticket": "Ticket 25 · Question 14",
   "title": "When turning right you must give way to:",
   "options": [
    "Only for cyclists",
    "Pedestrians only",
    "Pedestrians and cyclists"
   ],
   "explanation": "When turning right or left, the driver is obliged to give way to pedestrians, people using SIM cards for movement and cyclists crossing the roadway on which he is turning. This rule for driving through intersections applies to both controlled and unregulated intersections. (Clause 13.1 of the Traffic Rules)",
   "pddRule": "п. 13.1"
  },
  "kk": {
   "ticket": "25-билет · 14-сұрақ",
   "title": "Оңға бұрылған кезде мыналарға жол беру керек:",
   "options": [
    "Тек велосипедшіге",
    "Тек жаяу жүргіншілер",
    "Жаяу жүргіншілер мен велосипедшілер"
   ],
   "explanation": "Оңға немесе солға бұрылу кезінде жүргізуші жаяу жүргіншілерге, қозғалыс үшін жеке мобильді құралдарды (ЖМҚ) пайдаланатын адамдарға және өзі бұрылатын жол бөлігін кесіп өтетін велосипедшілерге жол беруге міндетті. Қиылыстар арқылы жүруге арналған бұл ереже басқарылатын және реттелмейтін қиылыстарға да қолданылады. (Жол қозғалысы ережесінің 13.1 тармағы)",
   "pddRule": "п. 13.1"
  }
 },
