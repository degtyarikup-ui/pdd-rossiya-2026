 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 25 · Вопрос 13",
   "title": "Значения каких дорожных знаков отменяются сигналами светофора?",
   "options": [
    "Знаков приоритета",
    "Запрещающих знаков",
    "Предписывающих знаков",
    "Всех перечисленных знаков"
   ],
   "explanation": "Движение регулируется: регулировщиком, сигналами светофора, знаками приоритета, разметкой, дорожным покрытием, «правилом правой руки». По вышеперечисленному «принципу приоритетности регулирования дорожного движения» знаки приоритета работают (т.е. ими мы руководствуемся) в том случае, когда отсутствует регулировщик, светофор выключен, неисправен, переведён в «жёлтый мигающий режим».(«Дорожные знаки», пункты 6.15 и 13.3 ПДД)",
   "pddRule": "п. 6.15"
  },
  "en": {
   "ticket": "Ticket 25 · Question 13",
   "title": "The meanings of which road signs are canceled by traffic lights?",
   "options": [
    "Priority signs",
    "Prohibition signs",
    "Mandatory signs",
    "All listed signs"
   ],
   "explanation": "Traffic is regulated by: traffic controllers, traffic signals, priority signs, markings, road surfaces, and the “right-hand rule.” According to the above-mentioned “principle of priority for traffic regulation,” priority signs work (i.e., we are guided by them) in the case when there is no traffic controller, the traffic light is turned off, faulty, or switched to “yellow flashing mode.” (“Road Signs”, paragraphs 6.15 and 13.3 of the Traffic Regulations)",
   "pddRule": "п. 6.15"
  },
  "kk": {
   "ticket": "25-билет · 13-сұрақ",
   "title": "Бағдаршам қандай жол белгілерінің мағынасын жояды?",
   "options": [
    "Басымдық белгілері",
    "Тыйым салу белгілері",
    "Міндетті белгілер",
    "Барлық көрсетілген белгілер"
   ],
   "explanation": "Қозғалыс келесілер арқылы реттеледі: жол реттеушілері, бағдаршамдар, басымдық белгілері, белгілер, жол төсемдері және «оң қол ережесі». Жоғарыда аталған «Жол қозғалысын реттеудің басымдылық қағидасына» сәйкес, басымдық белгілері жол реттеушісі болмаған, бағдаршам сөнген, ақаулы болған немесе «сары жыпылықтау режиміне» ауысқан жағдайда жұмыс істейді (яғни, біз оларды басшылыққа аламыз). («Жол белгілері», Жол қозғалысы ережелерінің 6.15 және 13.3-тармақтары)",
   "pddRule": "п. 6.15"
  }
 },
