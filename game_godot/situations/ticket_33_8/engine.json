 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 33 · Вопрос 8",
   "title": "Разрешается ли Вам выполнить поворот направо по указанной траектории в данной ситуации?",
   "options": [
    "Разрешается",
    "Запрещается"
   ],
   "explanation": "При повороте направо транспортное средство должно двигаться по возможности ближе к правому краю проезжей части, т.е. по крайней правой полосе. В данном случае у Вас такой возможности нет по причине остановки на этой полосе легкового автомобиля. Продолжаете движение по указанной траектории.(Пункт 8.6 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 33 · Question 8",
   "title": "Are you allowed to make a right turn along the indicated trajectory in this situation?",
   "options": [
    "Allowed",
    "Prohibited"
   ],
   "explanation": "When turning right, the vehicle should move as close as possible to the right edge of the roadway, i.e. in the far right lane. In this case, you do not have such an opportunity due to the car stopping in this lane. Continue moving along the indicated trajectory. (Clause 8.6 of the traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "33-билет · 8-сұрақ",
   "title": "Бұл жағдайда көрсетілген траектория бойынша оңға бұрылуға рұқсат ете ме?",
   "options": [
    "Рұқсат етілген",
    "Тыйым салынған"
   ],
   "explanation": "Оңға бұрылған кезде көлік құралы жолдың оң жақ шетіне мүмкіндігінше жақын, яғни оң жақ шеткі жолақпен қозғалуы керек. Бұл жағдайда көліктің осы жолақта тоқтауына байланысты сізде мұндай мүмкіндік жоқ. Көрсетілген траектория бойынша қозғалуды жалғастырыңыз. (Жол қозғалысы ережесінің 8.6 тармағы)",
   "pddRule": ""
  }
 },
