 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 8 · Вопрос 13",
   "title": "Кто из водителей, выполняющих поворот, нарушит Правила?",
   "options": [
    "Оба",
    "Только водитель легкового автомобиля",
    "Только водитель мотоцикла",
    "Никто не нарушит"
   ],
   "explanation": "Знак 4.1.1 «Движение прямо» в данном случае установлен непосредственно перед пересечением проезжих частей, т.е перед перекрестком. Можно продолжать движение только прямо. В данной ситуации нарушают Правила оба водителя.(«Дорожные знаки»)",
   "pddRule": "п. 13.4"
  },
  "en": {
   "ticket": "Ticket 8 · Question 13",
   "title": "Which driver making a turn will violate the Rules?",
   "options": [
    "Both",
    "Car driver only",
    "Motorcycle driver only",
    "No one will break"
   ],
   "explanation": "Sign 4.1.1 “Move straight” in this case is installed immediately before the intersection of roadways, i.e. before the intersection. You can only continue moving straight ahead. In this situation, both drivers violate the Rules. (“Road Signs”)",
   "pddRule": "п. 13.4"
  },
  "kk": {
   "ticket": "8-билет · 13-сұрақ",
   "title": "Бұрылыс жасаған қай жүргізуші Ережені бұзады?",
   "options": [
    "Екеуі де",
    "Тек көлік жүргізушісі",
    "Тек мотоцикл жүргізушісі",
    "Ешкім сынбайды"
   ],
   "explanation": "4.1.1 «Тіке жүріңіз» белгісі бұл жағдайда жолдардың қиылысуының алдында, яғни қиылыс алдында орнатылады. Сіз тек алға жылжуды жалғастыра аласыз. Бұл жағдайда екі жүргізуші де Ережені бұзады. («Жол белгілері»)",
   "pddRule": "п. 13.4"
  }
 },
