 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 29 · Вопрос 14",
   "title": "Вы намерены повернуть налево. Ваши действия?",
   "options": [
    "Уступите дорогу трамваю, выполнив поворот с левой полосы",
    "Пропустите трамвай, перестроитесь на трамвайные пути попутного направления, после чего выполните поворот",
    "Проедете перекресток первым"
   ],
   "explanation": "Вы и трамвай находитесь в равнозначных условиях. Трамвай в таком случае имеет преимущество перед безрельсовыми транспортными средствами. Уступаете дорогу трамваю.(Пункт 13.11 ПДД)",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 29 · Question 14",
   "title": "You intend to turn left. What are your actions?",
   "options": [
    "Give way to the tram by turning from the left lane",
    "Let the tram pass, change lanes onto tram tracks in the same direction, and then make a turn",
    "Pass the intersection first"
   ],
   "explanation": "You and the tram are in equal conditions. In this case, the tram has an advantage over trackless vehicles. Give way to the tram. (Clause 13.11 of the traffic rules)",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "29-билет · 14-сұрақ",
   "title": "Сіз солға бұрылғыңыз келеді. Сіздің әрекеттеріңіз қандай?",
   "options": [
    "Сол жақ жолақтан бұрылу арқылы трамвайға жол беріңіз",
    "Трамвайға жол беріңіз, сол бағытта трамвай жолдарына жолақтарды ауыстырыңыз, содан кейін бұрылыс жасаңыз",
    "Алдымен қиылыстан өтіңіз"
   ],
   "explanation": "Сіз де, трамвай да бірдей жағдайдасыз. Бұл жағдайда трамвайдың рельссіз көліктерден артықшылығы бар. Трамвайға жол беріңіз. (Жол қозғалысы ережелерінің 13.11 тармағы)",
   "pddRule": "п. 13.11"
  }
