 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 18 · Вопрос 13",
   "title": "Обязаны ли Вы уступить дорогу легковому автомобилю при повороте направо?",
   "options": [
    "Обязаны",
    "Обязаны, если легковой автомобиль поворачивает налево",
    "Не обязаны"
   ],
   "explanation": "Перекрёсток регулируемый. Знаки приоритета «не работают». При повороте налево водитель легкового автомобиля обязан уступить дорогу транспортным средствам, движущимся со встречного направления прямо или направо. У Вас преимущество.(Пункты 13.3, 13.4 ПДД)",
   "pddRule": "п. 13.4"
  },
  "en": {
   "ticket": "Ticket 18 · Question 13",
   "title": "Are you required to give way to a passenger car when turning right?",
   "options": [
    "Required",
    "Obligated if the car is turning left",
    "Not required"
   ],
   "explanation": "Adjustable intersection. Priority signs \"do not work\". When turning left, the driver of the passenger car is obliged to give way to vehicles moving from the opposite direction directly or to the right. You have the advantage.(Clauses 13.3, 13.4 of the Traffic Rules)",
   "pddRule": "п. 13.4"
  },
  "kk": {
   "ticket": "18-билет · 13-сұрақ",
   "title": "Оңға бұрылған кезде көлікке жол беру керек пе?",
   "options": [
    "Міндетті",
    "Көлік солға бұрылса міндетті",
    "Міндетті емес"
   ],
   "explanation": "Қиылыс реттелетін. Басымдық белгілері жұмыс істемейді. Солға бұрылу кезінде көлік жүргізушісі қарама-қарсы бағыттан тура немесе оңға қарай қозғалатын көлік құралдарына жол беруге міндетті. Сізде артықшылық бар. (Жол қозғалысы ережелерінің 13.3, 13.4-тармақтары)",
   "pddRule": "п. 13.4"
  }
 },
