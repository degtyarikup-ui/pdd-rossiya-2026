 "text": {
  "ru": {
   "ticket": "Билет 24 · Вопрос 9",
   "title": "Разрешается ли Вам выполнить разворот?",
   "options": [
    "Разрешается",
    "Разрешается только по траектории А",
    "Разрешается только по траектории Б",
    "Запрещается"
   ],
   "explanation": "Производить разворот на перекрестках, обозначенных знаком 5.7.2 «Выезд на дорогу с односторонним движением» (траектория «А») разрешается. Разворот по траектории «Б» совершать нельзя, т.к. он запрещен на пешеходных переходах». В данном случае границами пешеходного перехода являются знаки 5.19.1, 5.19.2 «Пешеходный переход»(«Дорожные знаки», пункт 8.11 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 24 · Question 9",
   "title": "Are you allowed to make a U-turn?",
   "options": [
    "Allowed",
    "Allowed only along trajectory А",
    "Allowed only along trajectory Б",
    "Prohibited"
   ],
   "explanation": "It is permitted to make a U-turn at intersections marked with sign 5.7.2 “Entering a one-way road” (trajectory “А”). A turn along trajectory “Б” cannot be made, because it is prohibited at pedestrian crossings.” In this case, the boundaries of the pedestrian crossing are signs 5.19.1, 5.19.2 “Pedestrian crossing” (“Road signs”, clause 8.11 of the traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "24-билет · 9-сұрақ",
   "title": "Сізге кері бұрылыс жасауға рұқсат бар ма?",
   "options": [
    "Рұқсат етілген",
    "А траекториясы бойынша ғана рұқсат етіледі",
    "Тек Б траекториясы бойынша рұқсат етіледі",
    "Тыйым салынған"
   ],
   "explanation": "5.7.2 «Бір жақты жолға шығу» («А» траекториясы) белгісімен белгіленген қиылыстарда кері бұрылыс жасауға рұқсат етіледі. «Б» траекториясы бойынша кері бұрылыс жасауға болмайды, өйткені жаяу жүргіншілер өткелінде оған тыйым салынады». Бұл ретте жаяу жүргіншілер өткелінің шекаралары 5.19.1, 5.19.2 «Жаяу жүргіншілер өткелі» («Жол белгілері», Жол қозғалысы ережелерінің 8.11 тармағы) белгілері болып табылады.",
   "pddRule": ""
  }
 },
