 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 33 · Вопрос 14",
   "title": "Вы намерены повернуть налево. Ваши действия?",
   "options": [
    "Проедете перекрёсток первым",
    "Выедете на перекресток первым и, уступив дорогу мотоциклу, завершите поворот",
    "Уступите дорогу обоим транспортным средствам"
   ],
   "explanation": "Перекрёсток равнозначный. Водители между собой руководствуются «правилом правой руки». Первым начинаете движение Вы, поскольку в первоначальный момент не имеете помехи справа. Выкатившись на перекрёсток, перед самым поворотом налево останавливаетесь, так как справа от Вас по траектории движения находится мотоцикл. После того, как мотоцикл проедет, Вы можете завершить маневр. Легковое ТС проедет перекресток последним.(Пункт 13.11 ПДД)",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 33 · Question 14",
   "title": "You intend to turn left. What are your actions?",
   "options": [
    "Pass the intersection first",
    "Enter the intersection first and, giving way to the motorcycle, complete the turn",
    "Give way to both vehicles"
   ],
   "explanation": "The intersection is equal. Drivers follow the “right-hand rule” among themselves. You start moving first, because at the initial moment there is no obstacle on the right. Having rolled out to the intersection, you stop just before turning left, since there is a motorcycle to your right along the trajectory of movement. Once the motorcycle has passed, you can complete the maneuver. The passenger vehicle will be the last to cross the intersection. (Clause 13.11 of the traffic rules)",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "33-билет · 14-сұрақ",
   "title": "Сіз солға бұрылғыңыз келеді. Сіздің әрекеттеріңіз қандай?",
   "options": [
    "Алдымен қиылыстан өтіңіз",
    "Алдымен қиылысқа кіріп, мотоциклге жол беріп, бұрылысты аяқтаңыз",
    "Екі көлікке де жол беріңіз"
   ],
   "explanation": "Қиылысу тең. Жүргізушілер өзара «оң қол ережесін» сақтайды. Сіз бірінші қозғала бастайсыз, өйткені бастапқы сәтте оң жақта ешқандай кедергі жоқ. Қиылысқа шығып, солға бұрылар алдында тоқтайсыз, өйткені қозғалыс траекториясы бойынша оң жақта мотоцикл бар. Мотоцикл өткеннен кейін маневрді аяқтауға болады. Жеңіл автомобиль қиылыстан соңғы болып өтеді. (Жол қозғалысы ережелерінің 13.11 тармағы)",
   "pddRule": "п. 13.11"
  }
 },
