extends SceneTree

func _initialize() -> void:
	var run := Run.new()
	run.answer("ticket_1_1", false)
	run.answer("ticket_1_2", true)
	var saved := run.summary()
	assert(saved.answer_log.size() == 2)
	assert(saved.answer_log[0].situation == "ticket_1_1" and not saved.answer_log[0].correct)
	assert(saved.answer_log[1].correct and saved.answer_log[1].answeredAt > saved.answer_log[0].answeredAt)
	var resumed := Run.new()
	resumed.restore(saved)
	resumed.answer("ticket_1_1", true)
	assert(resumed.summary().answer_log.size() == 3)
	assert(resumed.answer_log[0] == saved.answer_log[0])
	assert(saved.answer_log.size() == 2, "A returned summary must not grow when the run continues")
	assert(resumed.answer_log[2].answeredAt > resumed.answer_log[1].answeredAt)
	var legacy := Run.new()
	legacy.restore({"answered": 2, "correct": 1, "mistakes": ["ticket_1_1"]})
	assert(legacy.answer_log.is_empty(), "Old runs have no invented answer times")
	legacy.answer("ticket_1_2", true)
	assert(legacy.answered == 3 and legacy.answer_log.size() == 1)
	print("PASS: city answer log survives resume with original timestamps and independent summaries")
	quit()
