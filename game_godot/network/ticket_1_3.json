 "question": {
  "text": {
   "ru": {
    "ticket": "Билет 1 · Вопрос 3",
    "title": "Можно ли Вам остановиться в указанном месте для посадки пассажира?",
    "options": [
     "Можно",
     "Можно, если Вы управляете такси",
     "Нельзя"
    ],
    "explanation": "Знак 3.28 «Стоянка запрещена» не запрещает производить остановку. В указанном месте Вам совершить остановку можно.(«Дорожные знаки»)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 1 · Question 3",
    "title": "Can you stop at the designated location to pick up a passenger?",
    "options": [
     "Can",
     "Yes, if you drive a taxi",
     "It is forbidden"
    ],
    "explanation": "Sign 3.28 “Parking prohibited” does not prohibit stopping. You can stop at the indicated place. (“Road signs”)",
    "pddRule": ""
   },
   "kk": {
    "ticket": "1-билет · 3-сұрақ",
    "title": "Жолаушыны алу үшін белгіленген жерге тоқтай аласыз ба?",
    "options": [
     "Иә",
     "Иә, егер сіз такси айдасаңыз",
     "Ол тыйым салынған"
    ],
    "explanation": "3.28 «Автотұрақ жоқ» белгісі тоқтауға тыйым салмайды. Көрсетілген жерде тоқтауға болады. («Жол белгілері»)",
    "pddRule": ""
   }
