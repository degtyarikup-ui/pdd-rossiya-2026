 "question": {
  "text": {
   "ru": {
    "ticket": "Билет 11 · Вопрос 8",
    "title": "По какой траектории Вам разрешено выполнить поворот направо?",
    "options": [
     "Только по А",
     "Только по Б",
     "По любой из указанных"
    ],
    "explanation": "При повороте направо транспортное средство должно двигаться по возможности ближе к правому краю проезжей части. У Вас такая возможность есть, продолжаете при повороте направо движение по траектории «А».(Пункт 8.6 ПДД)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 11 · Question 8",
    "title": "Which trajectory are you allowed to turn right?",
    "options": [
     "Only on А",
     "Only on Б",
     "For any of these"
    ],
    "explanation": "When turning right, the vehicle should move as close as possible to the right edge of the roadway. You have such an opportunity; when turning right, continue driving along trajectory “А”. (Clause 8.6 of the Traffic Regulations)",
    "pddRule": ""
   },
   "kk": {
    "ticket": "11-билет · 8-сұрақ",
    "title": "Оңға бұрылу үшін қандай траекториямен жүруге рұқсат етіледі?",
    "options": [
     "Тек А",
     "Тек Б",
     "Жоғарыда аталғандардың кез келгені бойынша"
    ],
    "explanation": "Оңға бұрылған кезде көлік құралы жолдың оң жақ шетіне мүмкіндігінше жақын қозғалуы керек. Сізде мұндай мүмкіндік бар; оңға бұрылған кезде «А» траекториясы бойынша жүре беріңіз. (Жол қозғалысы ережесінің 8.6 тармағы)",
    "pddRule": ""
   }
