 "question": {
  "text": {
   "ru": {
    "ticket": "Билет 23 · Вопрос 15",
    "title": "Кому Вы обязаны уступить дорогу при повороте налево?",
    "options": [
     "Обоим транспортным средствам",
     "Только автобусу",
     "Только легковому автомобилю",
     "Никому"
    ],
    "explanation": "Перекрёсток неравнозначный. Главная дорога меняет направление. Транспортные средства, находящиеся на главной дороге, имеют преимущество, между собой руководствуются «правилом правой руки». У Вас помеха справа – уступаете автобусу.(Пункты 13.9, 13.10, 13.11 ПДД)",
    "pddRule": "п. 13.9"
   },
   "en": {
    "ticket": "Ticket 23 · Question 15",
    "title": "Who do you have to give way to when turning left?",
    "options": [
     "Both vehicles",
     "Only by bus",
     "Passenger car only",
     "Nobody"
    ],
    "explanation": "The intersection is unequal. The main road changes direction. Vehicles on the main road have priority and are guided by the “right-hand rule” among themselves. You have an obstacle on the right - give way to the bus. (Clause 13.9, 13.10, 13.11 Traffic Rules)",
    "pddRule": "п. 13.9"
   },
   "kk": {
    "ticket": "23-билет · 15-сұрақ",
    "title": "Солға бұрылғанда кімге жол беру керек?",
    "options": [
     "Екі көлік те",
     "Тек автобусқа",
     "Тек жеңіл автомобильге",
     "Ешкім"
    ],
    "explanation": "Қиылысу тең емес. Негізгі жол бағытын өзгертеді. Негізгі жолдағы көліктер басымдыққа ие және өз араларында «оң қол ережесін» басшылыққа алады. Сізде оң жақта кедергі бар - автобусқа жол беріңіз. (Жол қозғалысы ережелерінің 13.9, 13.10, 13.11 тармақтары)",
    "pddRule": "п. 13.9"
   }
