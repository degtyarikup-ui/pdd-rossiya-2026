   "ru": {
    "ticket": "Билет 35 · Вопрос 8",
    "title": "Кому Вы должны уступить дорогу при повороте во двор?",
    "options": [
     "Только встречному автомобилю",
     "Встречному автомобилю и пешеходам",
     "Никому"
    ],
    "explanation": "При повороте налево вне перекрестка водитель безрельсового ТС обязан уступить дорогу встречным ТС, лицам, использующим для передвижения СИМ и пешеходам, путь движения которых он пересекает.(Пункты 8.3, 8.8 ПДД)",
    "pddRule": ""
   },
   "en": {
    "ticket": "Ticket 35 · Question 8",
    "title": "Who should you give way to when turning into the yard?",
    "options": [
     "Only for oncoming cars",
     "To oncoming cars and pedestrians",
     "Nobody"
    ],
    "explanation": "When turning left outside an intersection, the driver of a trackless vehicle is obliged to give way to oncoming vehicles, persons using a SIM card for movement, and pedestrians whose movement path he crosses. (Clause 8.3, 8.8 of the Traffic Regulations)",
    "pddRule": ""
   },
   "kk": {
    "ticket": "35-билет · 8-сұрақ",
    "title": "Аулаға бұрылғанда кімге жол беру керек?",
    "options": [
     "Тек қарсы келе жатқан көлікке",
     "Қарсы келе жатқан көліктер мен жаяу жүргіншілерге",
     "Ешкім"
    ],
    "explanation": "Жол қиылысынан тыс солға бұрылған кезде рельссіз көлік құралының жүргізушісі қарсы келе жатқан көліктерге, қозғалыс үшін жеке қозғалыс құралдарын пайдаланатын адамдарға және қозғалыс жолын кесіп өтетін жаяу жүргіншілерге жол беруге міндетті. (Жол қозғалысы ережесінің 8.3, 8.8 тармақтары)",
    "pddRule": ""
   }
