 "text": {
  "ru": {
   "ticket": "Билет 12 · Вопрос 5",
   "title": "Движение разрешается:",
   "options": [
    "Только по траектории А",
    "Только по траектории Б",
    "По любой траектории из указанных"
   ],
   "explanation": "Линию горизонтальной разметки 1.11 разрешается пересекать со стороны прерывистой, а также и со стороны сплошной, но только при завершении обгона или объезда. Водитель «А», выезжающий со двора, нарушает Правила. Разрешается движение автомобиля, совершающего разворот по траектории «Б».(«Горизонтальная разметка»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 12 · Question 5",
   "title": "Movement is permitted:",
   "options": [
    "Only along trajectory А",
    "Only along trajectory Б",
    "Along any trajectory of the specified"
   ],
   "explanation": "Horizontal marking line 1.11 is allowed to be crossed from the broken side, as well as from the solid side, but only when overtaking or detour is completed. Driver “А” leaving the yard violates the Rules. A vehicle making a U-turn along trajectory “Б” is allowed to move (“Horizontal marking”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "12-билет · 5-сұрақ",
   "title": "Қозғалыс рұқсат етіледі:",
   "options": [
    "Тек А траекториясы бойынша",
    "Тек Б траекториясы бойынша",
    "Көрсетілген жолдардың кез келгенінде"
   ],
   "explanation": "Көлденең таңбалау сызығы 1.11 үзік жағынан, сондай-ақ тұтас жағынан кесіп өтуге рұқсат етіледі, бірақ басып озу немесе айналып өту аяқталғаннан кейін ғана. «А» жүргізуші ауладан шығып, Ережені бұзады. «Б» траекториясы бойынша кері бұрылатын көлік құралының қозғалуына рұқсат етіледі («Көлденең таңбалар»)",
   "pddRule": ""
  }
 },
