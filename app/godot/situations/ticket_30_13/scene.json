 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 30 · Вопрос 13",
   "title": "В каком случае Вы обязаны уступить дорогу грузовому автомобилю?",
   "options": [
    "При повороте налево",
    "При развороте",
    "В обоих перечисленных случаях"
   ],
   "explanation": "Перекрёсток регулируемый. Вам разрешено движение. При повороте налево, развороте следует уступить дорогу транспортным средствам, движущимся со встречного направления прямо и направо. Уступаете грузовику в обоих перечисленных случаях.(Пункты 13.3, 13.4 ПДД)",
   "pddRule": "п. 13.3"
  },
  "en": {
   "ticket": "Ticket 30 · Question 13",
   "title": "In what case are you required to give way to a truck?",
   "options": [
    "When turning left",
    "When making a U-turn",
    "In both of the above cases"
   ],
   "explanation": "The intersection is controlled. You are allowed to move. When turning left or making a U-turn, you must give way to vehicles moving straight and to the right from the opposite direction. Yield to the truck in both of the listed cases. (Clause 13.3, 13.4 of the traffic rules)",
   "pddRule": "п. 13.3"
  },
  "kk": {
   "ticket": "30-билет · 13-сұрақ",
   "title": "Қандай жағдайда жүк көлігіне жол беру керек?",
   "options": [
    "Солға бұрылғанда",
    "Кері бұрылғанда",
    "Жоғарыда аталған екі жағдайда да"
   ],
   "explanation": "Қиылыс реттелетін. Сізге қозғалуға рұқсат етілген. Солға бұрылу немесе кері бұрылу кезінде қарама-қарсы бағыттан түзу және оңға қарай қозғалатын көліктерге жол беру керек. Көрсетілген екі жағдайда да жүк көлігіне жол беру керек. (Жол қозғалысы ережесінің 13.3, 13.4 тармақтары)",
   "pddRule": "п. 13.3"
  }
 },
