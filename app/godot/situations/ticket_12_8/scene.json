 "text": {
  "ru": {
   "ticket": "Билет 12 · Вопрос 8",
   "title": "Кто должен уступить дорогу при одновременном перестроении?",
   "options": [
    "Водитель легкового автомобиля",
    "Водитель мотоцикла",
    "В данной ситуации водителям следует действовать по взаимной договоренности"
   ],
   "explanation": "При одновременном перестроении водители руководствуются «правилом правой руки». Помеха у водителя легкового автомобиля. Он уступает дорогу.(Пункт 8.4 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 12 · Question 8",
   "title": "Who must give way when changing lanes at the same time?",
   "options": [
    "Car driver",
    "Motorcycle driver",
    "In this situation, drivers should act by mutual agreement"
   ],
   "explanation": "When changing lanes at the same time, drivers are guided by the “right-hand rule.” Interference with the driver of a car. He gives way. (Clause 8.4 of traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "12-билет · 8-сұрақ",
   "title": "Жолақтарды бір уақытта ауыстырған кезде кім жол беруі керек?",
   "options": [
    "Көлік жүргізушісі",
    "Мотоцикл жүргізушісі",
    "Мұндай жағдайда жүргізушілер өзара келісім бойынша әрекет етуі керек"
   ],
   "explanation": "Жолақтарды бір уақытта ауыстырған кезде жүргізушілер «оң қол ережесін» басшылыққа алады. Жеңіл автомобиль жүргізушісінің оң жағында кедергі бар. Ол жол береді. (Жол қозғалысы ережелерінің 8.4 тармағы)",
   "pddRule": ""
  }
