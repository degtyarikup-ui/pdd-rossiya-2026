 "text": {
  "ru": {
   "ticket": "Билет 29 · Вопрос 6",
   "title": "В каком месте Вы должны остановиться?",
   "options": [
    "Перед светофором",
    "Перед стоп-линией",
    "В любом из перечисленных"
   ],
   "explanation": "При наличии стоп-линии (разметки 1.12) при запрещающем сигнале светофора следует остановиться перед стоп-линией.(«Горизонтальная разметка», пункт 6.13 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 29 · Question 6",
   "title": "Where should you stop?",
   "options": [
    "Before the traffic light",
    "Before the stop line",
    "In any of the above"
   ],
   "explanation": "If there is a stop line (marking 1.12) at a prohibitory traffic light signal, you should stop in front of the stop line. (“Horizontal markings”, clause 6.13 of the traffic rules)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "29-билет · 6-сұрақ",
   "title": "Қай жерде тұру керек?",
   "options": [
    "Бағдаршамның алдында",
    "Тоқтату сызығы алдында",
    "Жоғарыда аталғандардың кез келгенінде"
   ],
   "explanation": "Тыйым салатын бағдаршам сигналында тоқтау сызығы (1.12 белгісі) болса, тоқтау сызығының алдында тоқтау керек. («Көлденең таңбалар», Жол қозғалысы ережелерінің 6.13 тармағы)",
   "pddRule": ""
  }
