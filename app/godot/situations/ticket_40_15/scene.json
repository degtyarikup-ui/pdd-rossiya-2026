 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 40 · Вопрос 15",
   "title": "Кому Вы обязаны уступить дорогу при повороте налево?",
   "options": [
    "Только автобусу",
    "Только грузовому автомобилю",
    "Обоим транспортным средствам"
   ],
   "explanation": "Перед Вами знак 2.4 «Уступите дорогу». Уступаете дорогу транспортным средствам, движущимся по пересекаемой дороге, в данной ситуации обоим транспортным средствам.(Пункт 13.9 ПДД, «Дорожные знаки»)",
   "pddRule": "п. 13.9"
  },
  "en": {
   "ticket": "Ticket 40 · Question 15",
   "title": "Who do you have to give way to when turning left?",
   "options": [
    "Only by bus",
    "Truck only",
    "Both vehicles"
   ],
   "explanation": "In front of you is sign 2.4 “Give way.” Give way to vehicles moving along the road you are crossing, in this situation to both vehicles. (Clause 13.9 of the Traffic Regulations, “Road Signs”)",
   "pddRule": "п. 13.9"
  },
  "kk": {
   "ticket": "40-билет · 15-сұрақ",
   "title": "Солға бұрылғанда кімге жол беру керек?",
   "options": [
    "Тек автобусқа",
    "Тек жүк көлігіне",
    "Екі көлік те"
   ],
   "explanation": "Сіздің алдыңызда 2.4 «Жол беріңіз» белгісі. Сіз өтіп бара жатқан жол бойымен қозғалатын көліктерге, бұл жағдайда екі көлікке де жол беріңіз. (Жол қозғалысы ережесінің 13.9 тармағы, «Жол белгілері»)",
   "pddRule": "п. 13.9"
  }
