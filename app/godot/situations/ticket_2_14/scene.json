 "labels": [],
 "text": {
  "ru": {
   "ticket": "Билет 2 · Вопрос 14",
   "title": "В каком случае Вы имеете преимущество?",
   "options": [
    "Только при повороте направо",
    "Только при повороте налево",
    "В обоих перечисленных случаях"
   ],
   "explanation": "Перекресток равнозначный. Водители между собой руководствуются «правилом правой руки», т. е. у кого помеха справа, тот и уступает. У Вас преимущество и при повороте направо и при повороте налево, т. е. в обоих перечисленных случаях.(Пункт 13.11 ПДД).",
   "pddRule": "п. 13.11"
  },
  "en": {
   "ticket": "Ticket 2 · Question 14",
   "title": "In which case do you have an advantage?",
   "options": [
    "Only when turning right",
    "Only when turning left",
    "In both of the above cases"
   ],
   "explanation": "The intersection is equivalent. Drivers are guided by the “right-hand rule” among themselves, i.e. whoever has an obstacle on the right gives way. You have an advantage both when turning right and when turning left, i.e. in both of these cases (Clause 13.11 of the Traffic Regulations).",
   "pddRule": "п. 13.11"
  },
  "kk": {
   "ticket": "2-билет · 14-сұрақ",
   "title": "Қандай жағдайда сізде артықшылық бар?",
   "options": [
    "Тек оңға бұрылғанда",
    "Тек солға бұрылғанда",
    "Жоғарыда аталған екі жағдайда да"
   ],
   "explanation": "Қиылысу тең. Жүргізушілер өзара «оң қол ережесін» басшылыққа алады, яғни оң жақта кімнің кедергісі болса, сол жол береді. Оңға бұрылуда да, солға бұрылуда да, яғни осы екі жағдайда да артықшылығыңыз бар (Жол қозғалысы ережесінің 13.11 тармағы).",
   "pddRule": "п. 13.11"
  }
 },
