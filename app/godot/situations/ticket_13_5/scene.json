 "text": {
  "ru": {
   "ticket": "Билет 13 · Вопрос 5",
   "title": "Какой пешеходный переход обозначает данная разметка?",
   "options": [
    "Только регулируемый",
    "Только нерегулируемый",
    "Любой"
   ],
   "explanation": "Разметка 1.14.1 («зебра»), с использованием желтого фона в целях усиления ее восприятия водителями и, соответственно, повышения безопасности движения пешеходов применяется часто. Она может обозначать любой пешеходный переход – как регулируемый, так и нерегулируемый.(«Дорожная разметка»)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 13 · Question 5",
   "title": "Which pedestrian crossing does this marking indicate?",
   "options": [
    "Adjustable only",
    "Unregulated only",
    "Any"
   ],
   "explanation": "Marking 1.14.1 (“zebra”), using a yellow background, in order to enhance its perception by drivers and, accordingly, increase the safety of pedestrians, is often used. It can designate any pedestrian crossing - both regulated and unregulated. (“Road markings”)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "13-билет · 5-сұрақ",
   "title": "Бұл таңбалау қай жаяу жүргіншілер өткелін көрсетеді?",
   "options": [
    "Тек реттелетін",
    "Тек реттелмеген",
    "Кез келген"
   ],
   "explanation": "Жүргізушілердің оны қабылдауын жақсарту және сәйкесінше жаяу жүргіншілердің қауіпсіздігін арттыру үшін сары фонды пайдаланып 1.14.1 («зебра») белгісі жиі қолданылады. Ол кез келген жаяу жүргіншілер өткелін белгілей алады - реттелетін де, реттелмейтін де. («Жол белгілері»)",
   "pddRule": ""
  }
