  "ru": {
   "ticket": "Билет 21 · Вопрос 8",
   "title": "При повороте налево для въезда во двор Вы обязаны уступить дорогу:",
   "options": [
    "Только велосипедисту",
    "Только пешеходам",
    "Пешеходам и велосипедисту"
   ],
   "explanation": "При съезде с дороги, водитель должен уступить дорогу пешеходам и велосипедистам, путь движения которых он пересекает.(Пункт 8.3 ПДД)",
   "pddRule": ""
  },
  "en": {
   "ticket": "Ticket 21 · Question 8",
   "title": "When turning left to enter a yard, you must give way to:",
   "options": [
    "Only for cyclists",
    "Pedestrians only",
    "Pedestrians and cyclists"
   ],
   "explanation": "When leaving the road, the driver must give way to pedestrians and cyclists whose path he is crossing. (Clause 8.3 of the Traffic Regulations)",
   "pddRule": ""
  },
  "kk": {
   "ticket": "21-билет · 8-сұрақ",
   "title": "Аулаға кіру үшін солға бұрылған кезде мыналарға жол беру керек:",
   "options": [
    "Тек велосипедшілерге арналған",
    "Тек жаяу жүргіншілер",
    "Жаяу жүргіншілер мен велосипедшілер"
   ],
   "explanation": "Жүргізуші жолдан шыққан кезде өзі өтіп бара жатқан жаяу жүргіншілер мен велосипедшілерге жол беруге міндетті. (Жол қозғалысы ережесінің 8.3 тармағы)",
   "pddRule": ""
  }
