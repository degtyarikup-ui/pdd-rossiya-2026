# Пример окружения допускается, но без реальных значений секретов.
!.env.example

# Temporary links for standalone Godot exports; canonical photos are in assets/.
/game_godot/questions/*.webp
/game_godot/questions/*.webp.import
# MP3 derivatives of canonical studio Opus audio, shared by Flutter/Godot.
/assets/audio/game_questions/*.mp3
/assets/audio/game_questions/.manifest.json
# Temporary links for standalone game exports.
/game_godot/question_audio/*.mp3
/game_godot/question_audio/*.mp3.import

# Temporary links to canonical answer sounds for standalone Godot exports.
/game_godot/answer_audio/

# Shared achievement badges, exported from assets/ for the Godot package.
game_godot/icons/achievements/

game_godot/icons/streak_flame.svg
game_godot/icons/streak_flame.svg.import
